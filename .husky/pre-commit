#!/usr/bin/env sh
# Pre-commit hook for @mux/ai
# Automatically installed by Husky during npm install

echo "🔍 Running pre-commit checks..."

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

# Get staged TypeScript/JavaScript files
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(ts|tsx|js|jsx|mjs)$' || true)

if [ -z "$STAGED_FILES" ]; then
  echo "${GREEN}✅ No TypeScript/JavaScript files to check${NC}"
  exit 0
fi

FILE_COUNT=$(echo "$STAGED_FILES" | wc -l | tr -d ' ')
echo "📝 Checking ${YELLOW}${FILE_COUNT}${NC} staged file(s)"
echo ""

# ─────────────────────────────────────────────────────────────────────────────
# Run ESLint (handles formatting, code quality, filename conventions, etc.)
# ─────────────────────────────────────────────────────────────────────────────
echo "🧹 Running ESLint..."
if echo "$STAGED_FILES" | xargs npx eslint; then
  echo "${GREEN}✓ ESLint passed${NC}"
else
  echo "${RED}✗ ESLint failed${NC}"
  echo ""
  echo "${YELLOW}💡 Run 'npm run lint:fix' to auto-fix issues${NC}"
  exit 1
fi
echo ""

# ─────────────────────────────────────────────────────────────────────────────
# Run TypeScript type checking (not handled by ESLint)
# ─────────────────────────────────────────────────────────────────────────────
echo "🔎 Running TypeScript type check..."
if npm run typecheck --silent; then
  echo "${GREEN}✓ Type check passed${NC}"
else
  echo "${RED}✗ Type check failed${NC}"
  exit 1
fi

echo "🔎 Running TypeScript type check on tests..."
if npm run typecheck:tests --silent; then
  echo "${GREEN}✓ Test type check passed${NC}"
else
  echo "${RED}✗ Test type check failed${NC}"
  exit 1
fi
echo ""

echo "${GREEN}✅ All pre-commit checks passed!${NC}"
echo ""
